# --- Falha aberta ----------------------------------------------------------


def _tempo_esgotado(request: httpx.Request) -> httpx.Response:
    raise httpx.ReadTimeout("tempo esgotado", request=request)


@pytest.mark.usefixtures("com_content_safety")
@pytest.mark.parametrize(
    "responder",
