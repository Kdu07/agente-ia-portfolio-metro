<file path="src/middleware/app/rotinas/agendador.py">
"""Agenda dos prompts pré-programados.

APScheduler com jobstore SQLAlchemy sobre o PostgreSQL que já existe: a
agenda fica persistida no mesmo banco das interações, sem Redis, sem
broker e sem um quinto serviço no compose.

Roda no contêiner `worker`, separado da API. Duas razões: mantém a API
sem estado e evita disparo duplicado quando ela reinicia ou escala — com
o agendador embutido, duas réplicas da API produziriam dois relatórios.

Dois detalhes operacionais que este módulo precisa tratar explicitamente,
sob pena de a rotina disparar na hora errada ou várias vezes:

**Fuso.** "Todo dia 5 às 8h" significa 8h no fuso de quem cadastrou. O
`CronTrigger` recebe `timezone=rotina.timezone` — um cron interpretado em
UTC erra a hora durante boa parte do ano.

**Disparo perdido.** Se o worker estiver fora do ar no horário, o padrão
do APScheduler é descartar o disparo ou reexecutar em rajada ao voltar.
`coalesce=True` colapsa disparos acumulados num só e
`misfire_grace_time` define até quando um disparo atrasado ainda vale.
Sem os dois, o relatório do dia 5 sai três vezes às 14h.
"""

from __future__ import annotations

from datetime import UTC
from zoneinfo import ZoneInfo

from apscheduler.job import Job
from apscheduler.jobstores.base import JobLookupError
from apscheduler.jobstores.sqlalchemy import SQLAlchemyJobStore
from apscheduler.schedulers.asyncio import AsyncIOScheduler
from apscheduler.triggers.cron import CronTrigger
from apscheduler.triggers.interval import IntervalTrigger
from sqlalchemy.engine import make_url

from app.config import settings
from app.persistence.models import Rotina
from app.persistence.repository import RotinaRepository
from app.persistence.sessao import fabrica_de_sessoes

# Colapsa disparos acumulados durante uma indisponibilidade num único.
COALESCE = True

# Janela em que um disparo atrasado ainda é considerado válido. Uma hora:
# além disso, o relatório perdeu utilidade e é melhor pular do que enviar
# fora de contexto.
MISFIRE_GRACE_TIME_SEGUNDOS = 3600

# Uma execução por rotina por vez. Se a anterior ainda roda, a nova é
# descartada em vez de concorrer com ela.
MAX_INSTANCES = 1

PREFIXO_JOB_ROTINA = "rotina:"
JOB_RECONCILIACAO_ID = "sistema:reconciliar-rotinas"

_agendador: AsyncIOScheduler | None = None


def _url_sincrona_jobstore(database_url: str) -> str:
    """Troca somente o driver assíncrono pelo driver síncrono do jobstore."""
    url = make_url(database_url)
    drivers = {
        "postgresql+asyncpg": "postgresql+psycopg",
        "sqlite+aiosqlite": "sqlite+pysqlite",
    }
    driver = drivers.get(url.drivername, url.drivername)
    if driver.endswith(("+asyncpg", "+aiosqlite")):
        raise ValueError(f"Driver assíncrono sem equivalente para o jobstore: {url.drivername}")
    return url.set(drivername=driver).render_as_string(hide_password=False)


def _obter_agendador() -> AsyncIOScheduler:
    if _agendador is None:
        raise RuntimeError("O agendador ainda não foi criado")
    return _agendador


def _id_job(rotina_id: str) -> str:
    return f"{PREFIXO_JOB_ROTINA}{rotina_id}"


def criar_agendador() -> AsyncIOScheduler:
    """Cria uma única instância com jobstore persistente no PostgreSQL.

    O worker deve iniciá-la em modo pausado, executar ``carregar_agenda``
    e somente então liberar os disparos.
    """
    global _agendador
    if _agendador is not None:
        return _agendador

    _agendador = AsyncIOScheduler(
        jobstores={
            "default": SQLAlchemyJobStore(
                url=_url_sincrona_jobstore(settings.database_url),
                tablename="apscheduler_jobs",
                engine_options={"pool_pre_ping": True},
            )
        },
        job_defaults={
            "coalesce": COALESCE,
            "misfire_grace_time": MISFIRE_GRACE_TIME_SEGUNDOS,
            "max_instances": MAX_INSTANCES,
        },
        timezone=UTC,
    )
    _agendador.add_job(
        carregar_agenda,
        trigger=IntervalTrigger(
            seconds=settings.rotinas_reconciliacao_segundos,
            timezone=UTC,
        ),
        id=JOB_RECONCILIACAO_ID,
        name="Reconciliar rotinas ativas",
        replace_existing=True,
    )
    return _agendador


async def carregar_agenda() -> None:
    """Reconstrói a agenda a partir das rotinas ativas.

    Chamado na subida do worker. O jobstore persiste os jobs, mas a
    reconciliação com a tabela de rotinas é o que garante que uma rotina
    editada ou desativada enquanto o worker estava fora entre em vigor.
    """
    agendador = _obter_agendador()
    if not agendador.running:
        raise RuntimeError("Inicie o agendador pausado antes de reconciliar a agenda")

    async with fabrica_de_sessoes()() as sessao:
        rotinas = await RotinaRepository(sessao).listar_ativas()

    ids_ativos = {rotina.id for rotina in rotinas}
    for rotina in rotinas:
        agendar(rotina)

    for job in listar_agendadas():
        rotina_id = job.id.removeprefix(PREFIXO_JOB_ROTINA)
        if rotina_id not in ids_ativos:
            desagendar(rotina_id)


def agendar(rotina: Rotina) -> None:
    """Registra ou atualiza o job de uma rotina."""
    if not rotina.ativa:
        desagendar(rotina.id)
        return

    trigger = CronTrigger.from_crontab(
        rotina.agenda_cron,
        timezone=ZoneInfo(rotina.timezone),
    )
    _obter_agendador().add_job(
        executar_rotina_agendada,
        trigger=trigger,
        args=[rotina.id],
        id=_id_job(rotina.id),
        name=rotina.nome,
        replace_existing=True,
        coalesce=COALESCE,
        misfire_grace_time=MISFIRE_GRACE_TIME_SEGUNDOS,
        max_instances=MAX_INSTANCES,
    )


def desagendar(rotina_id: str) -> None:
    """Remove o job de uma rotina desativada ou excluída."""
    try:
        _obter_agendador().remove_job(_id_job(rotina_id))
    except JobLookupError:
        pass


def listar_agendadas() -> list[Job]:
    """Lista somente os jobs de rotinas, sem expor jobs internos."""
    return [
        job
        for job in _obter_agendador().get_jobs()
        if job.id.startswith(PREFIXO_JOB_ROTINA)
    ]


async def executar_rotina_agendada(rotina_id: str) -> None:
    """Busca o estado atual da rotina e o entrega ao executor da task #406."""
    async with fabrica_de_sessoes()() as sessao:
        rotina = await RotinaRepository(sessao).obter(rotina_id)

    if rotina is None or not rotina.ativa:
        desagendar(rotina_id)
        return

    # Import tardio evita acoplar a inicialização do scheduler ao grafo do
    # pipeline. A implementação do executor pertence à task #406.
    from app.rotinas.execucao import executar

    await executar(rotina)
</file>

<file path="src/middleware/app/rotinas/execucao.py">
"""Execução de uma rotina.

É aqui que a decisão mais importante do pacote se materializa: a rotina
entra pelo **mesmo orquestrador** que uma mensagem digitada, com
`canal=Canal.ROTINA`. Este módulo não importa `copilot/client.py`, e não
deve passar a importar.

A direção da dependência é a garantia:

    rotinas/execucao.py  ->  pipeline/orquestrador.py  ->  copilot/client.py

Se um dia aparecer uma seta direta de `rotinas/` para `copilot/`, as
guardas deixaram de ser obrigatórias e qualquer rotina cadastrada vira um
canal sem proteção — rodando periodicamente, sem ninguém olhando.

Identidade: a rotina executa como o dono, e o usuário é reconstruído no
momento do disparo, nunca guardado no cadastro. Uma permissão revogada
ontem precisa valer no disparo de hoje.
"""

import uuid
from dataclasses import replace
from datetime import UTC, datetime

from app.auth import entra, permissoes
from app.executor.fabrica import montar_executor
from app.persistence.models import Canal, ExecucaoRotina, Rotina, StatusExecucao
from app.persistence.repository import (
    ConversaRepository,
    ExecucaoRepository,
    InteracaoRepository,
    RotinaRepository,
    UsuarioRepository,
)
from app.persistence.repository_portfolio import UsuarioProjetoRepository
from app.persistence.sessao import fabrica_de_sessoes
from app.pipeline.desfechos import Desfecho
from app.pipeline.orquestrador import Orquestrador
from app.schemas.chat import ChatRequest, ChatResponse
from app.schemas.usuario import Permissao, UsuarioAutenticado


class RotinaNaoEncontrada(LookupError):
    """A rotina pedida para execução manual não existe."""


class ExecucaoNaoAutorizada(PermissionError):
    """O solicitante tentou executar a rotina de outra pessoa."""


class PermissaoRotinaRevogada(PermissionError):
    """O dono perdeu a permissão de gerenciar e executar rotinas."""


async def executar(rotina: Rotina) -> ChatResponse:
    """Dispara uma rotina através do pipeline completo.

    Passos previstos (onda 5):

    1. registrar o início em `ExecucaoRepository.registrar_inicio`, antes
       de qualquer chamada externa, para que uma rotina travada seja visível;
    2. reconstruir o `UsuarioAutenticado` do dono a partir do Entra ID —
       se o dono foi desativado, encerrar a execução com falha e
       desativar a rotina;
    3. chamar `Orquestrador.processar` com `canal=Canal.ROTINA` e
       `rotina_id=rotina.id`;
    4. fechar a execução com o status derivado do desfecho: `ENCAMINHADA`
       vira `SUCESSO`, qualquer desfecho bloqueado vira `BLOQUEADA`,
       exceção vira `FALHA`.

    O desfecho bloqueado NÃO é erro do sistema: significa que as guardas
    fizeram o trabalho delas sobre um prompt agendado. Aparece na tela de
    rotinas como tal, para que o dono corrija o enunciado.
    """
    execucao_id = str(uuid.uuid4())
    await _registrar_inicio(execucao_id, rotina.id)

    try:
        usuario = await _resolver_dono(rotina.dono_id)
        resposta = await _processar(rotina, usuario)
    except Exception as erro:
        desativar = isinstance(
            erro,
            (entra.UsuarioEntraInativo, PermissaoRotinaRevogada),
        )
        await _registrar_falha(execucao_id, rotina, erro, desativar=desativar)
        raise

    await _registrar_fim(
        execucao_id,
        status=_status_da_resposta(resposta),
        interacao_id=resposta.interacao_id,
    )
    resposta.execucao_id = execucao_id
    return resposta


async def executar_agora(rotina_id: str, solicitante_id: str) -> ChatResponse:
    """Dispara uma rotina sob demanda, a partir da tela de gestão.

    Existe para que o usuário teste a rotina sem esperar a data agendada.
    Verifica que `solicitante_id` é o dono: disparar a rotina de outro
    usuário executaria sob a identidade dele, o que seria escalada de
    privilégio pela porta dos fundos.
    """
    async with fabrica_de_sessoes()() as sessao:
        rotina = await RotinaRepository(sessao).obter(rotina_id)

    if rotina is None:
        raise RotinaNaoEncontrada(f"Rotina {rotina_id} não encontrada")
    if rotina.dono_id != solicitante_id:
        raise ExecucaoNaoAutorizada("Somente o dono pode executar esta rotina")
    return await executar(rotina)


async def _registrar_inicio(execucao_id: str, rotina_id: str) -> None:
    async with fabrica_de_sessoes()() as sessao:
        await ExecucaoRepository(sessao).registrar_inicio(
            ExecucaoRotina(
                id=execucao_id,
                rotina_id=rotina_id,
                iniciada_em=datetime.now(UTC),
                concluida_em=None,
                status=StatusExecucao.EM_EXECUCAO,
            )
        )
        await sessao.commit()


async def _resolver_dono(dono_id: str) -> UsuarioAutenticado:
    identidade = await entra.consultar_usuario(dono_id)
    if identidade.oid != dono_id:
        raise entra.FalhaConsultaDiretorio("Graph devolveu identidade diferente da solicitada")

    usuario = permissoes.resolver(identidade)
    if not usuario.pode(Permissao.GERIR_ROTINAS):
        raise PermissaoRotinaRevogada("Dono sem permissão atual para executar rotinas")

    async with fabrica_de_sessoes()() as sessao:
        projetos = await UsuarioProjetoRepository(sessao).listar_projetos_do_usuario(dono_id)
        await UsuarioRepository(sessao).garantir(
            usuario_id=usuario.id,
            nome=usuario.nome,
            perfil=usuario.perfil.value,
            email=usuario.email,
        )
        await sessao.commit()

    return replace(usuario, projetos=frozenset(projetos))


async def _processar(rotina: Rotina, usuario: UsuarioAutenticado) -> ChatResponse:
    async with fabrica_de_sessoes()() as sessao:
        try:
            orquestrador = Orquestrador(
                executor=montar_executor(sessao, usuario),
                interacoes=InteracaoRepository(sessao),
                conversas=ConversaRepository(sessao),
            )
            resposta = await orquestrador.processar(
                ChatRequest(mensagem=rotina.prompt),
                usuario,
                canal=Canal.ROTINA,
                rotina_id=rotina.id,
            )
            await sessao.commit()
            return resposta
        except Exception:
            await sessao.rollback()
            raise


def _status_da_resposta(resposta: ChatResponse) -> StatusExecucao:
    if resposta.desfecho == Desfecho.ENCAMINHADA.value:
        return StatusExecucao.SUCESSO
    if resposta.desfecho == Desfecho.FALHA_EXECUTOR.value:
        return StatusExecucao.FALHA
    return StatusExecucao.BLOQUEADA


async def _registrar_fim(
    execucao_id: str,
    *,
    status: StatusExecucao,
    interacao_id: str | None,
    erro: str | None = None,
) -> None:
    async with fabrica_de_sessoes()() as sessao:
        await ExecucaoRepository(sessao).registrar_fim(
            execucao_id,
            concluida_em=datetime.now(UTC),
            status=status.value,
            interacao_id=interacao_id,
            erro=erro,
        )
        await sessao.commit()


async def _registrar_falha(
    execucao_id: str,
    rotina: Rotina,
    erro: Exception,
    *,
    desativar: bool,
) -> None:
    if isinstance(erro, (entra.UsuarioEntraInativo, PermissaoRotinaRevogada)):
        mensagem = str(erro)
    elif isinstance(erro, entra.FalhaConsultaDiretorio):
        mensagem = "Não foi possível confirmar a identidade do dono no Microsoft Entra ID"
    else:
        mensagem = "Falha interna durante a execução da rotina"

    async with fabrica_de_sessoes()() as sessao:
        if desativar and rotina.ativa:
            await RotinaRepository(sessao).atualizar(replace(rotina, ativa=False))
        await ExecucaoRepository(sessao).registrar_fim(
            execucao_id,
            concluida_em=datetime.now(UTC),
            status=StatusExecucao.FALHA.value,
            erro=mensagem,
        )
        await sessao.commit()
