def test_latencia_guarda_saida(benchmark, monkeypatch) -> None:
    monkeypatch.setattr(settings, "content_safety_endpoint", "https://cs-teste.local/")
    monkeypatch.setattr(settings, "content_safety_key", "chave-de-teste")
