<file path="src/web/src/testes/utilitarios.tsx">
/**
 * Renderizacao com os provedores que a aplicacao usa.
 *
 * Toda tela depende de rota e de cliente de consulta. Montar um
 * componente sem eles testaria um objeto que nao existe em lugar nenhum
 * da aplicacao real.
 *
 * `retry: false` e `gcTime: 0` valem apenas no teste: repetir uma
 * requisicao que falhou de proposito faz a suite esperar sem motivo, e
 * cache entre casos faz um teste enxergar o resultado do anterior.
 */

import type { ReactElement, ReactNode } from "react";
import { render } from "@testing-library/react";
import { MemoryRouter } from "react-router-dom";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";

export function renderizar(elemento: ReactElement, rotaInicial = "/") {
  const cliente = new QueryClient({
    defaultOptions: { queries: { retry: false, gcTime: 0 } },
  });

  function Provedores({ children }: { children: ReactNode }) {
    return (
      <QueryClientProvider client={cliente}>
        <MemoryRouter
          initialEntries={[rotaInicial]}
          future={{ v7_startTransition: true, v7_relativeSplatPath: true }}
        >
          {children}
        </MemoryRouter>
      </QueryClientProvider>
    );
  }

  return render(elemento, { wrapper: Provedores });
}
</file>

<file path="src/web/src/utilitarios/formato.ts">
/**
 * Formatacao de data e hora para exibicao.
 *
 * Tudo em `America/Sao_Paulo` e locale pt-BR: o backend envia ISO 8601
 * com fuso, e deixar o navegador decidir faria a mesma interacao
 * aparecer com horarios diferentes para pessoas em maquinas configuradas
 * de forma distinta.
 */

const FUSO = "America/Sao_Paulo";

export function horaCurta(iso: string): string {
  return new Intl.DateTimeFormat("pt-BR", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: FUSO,
  }).format(new Date(iso));
}

export function dataCurta(iso: string): string {
  return new Intl.DateTimeFormat("pt-BR", {
    day: "2-digit",
    month: "short",
    timeZone: FUSO,
  }).format(new Date(iso));
}

/**
 * Rotulo relativo para listas de historico. Trocar "08 set, 14:32" por
 * "Hoje" no caso recente e o que permite bater o olho e localizar a
 * conversa sem ler a data inteira.
 */
export function quandoFoi(iso: string): string {
  const momento = new Date(iso);
  const agora = new Date();
  const umDia = 86_400_000;
  const diferenca = agora.getTime() - momento.getTime();

  if (diferenca < umDia && agora.getDate() === momento.getDate()) {
    return `Hoje, ${horaCurta(iso)}`;
  }
  if (diferenca < 2 * umDia) return `Ontem, ${horaCurta(iso)}`;
  return `${dataCurta(iso)}, ${horaCurta(iso)}`;
}
