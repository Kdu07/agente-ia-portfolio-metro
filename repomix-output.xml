<file path="src/web/src/componentes/graficos/README.md">
# Graficos do dashboard

Componentes de visualizacao dos recortes de `/intencoes/*`, sobre Recharts.
Recebem os dados prontos por propriedade e nao fazem requisicao: quem busca
e `hooks/usePainelIntencoes.ts`, e quem compoe e `paginas/Intencoes`.

Tres regras que valem para todos:

1. **Responsivo de verdade.** `ResponsiveContainer` do Recharts, e nao
   largura fixa: o dashboard precisa ser legivel no celular, onde uma
   legenda lateral nao cabe.
2. **Series de bloqueio nunca se somam.** Injecao, abuso e saida ficam em
   linhas separadas. Um total agregado esconderia tanto o incidente de
   seguranca quanto o problema de uso.
3. **Zero e informacao.** Uma intencao do catalogo com contagem zero
   aparece no grafico. Sumir da lista esconderia justamente o achado —
   uma classe que ninguem aciona.

## Componentes

| Componente | Recorte | Como cumpre as regras |
|---|---|---|
| `CartaoResumo` | Numeros de topo de cada recorte | Grade que passa de duas para quatro colunas conforme a largura |
| `BarrasPorIntencao` | `/intencoes/volume` | Barras horizontais com altura proporcional ao numero de intencoes; barra zerada ganha filete minimo e o rotulo "0" |
| `DistribuicaoDesfechos` | `/intencoes/desfechos` | Uma barra por desfecho, na ordem fixa do backend, com a cor da etiqueta do chat |
| `SerieBloqueios` | `/intencoes/seguranca/serie` | Uma linha por guarda, com cor e tracejado proprios; nenhuma linha de total |
| `TabelaEnunciados` | `/intencoes/catalogo/fora-de-escopo` e `/baixa-confianca` | Tabela com rolagem horizontal dentro do cartao em tela estreita |

Os tres graficos marcam o SVG como `aria-hidden` e repetem os dados numa
tabela fora da tela (`TabelaAcessivel`), que e o que o leitor de tela
consegue navegar. As cores ficam em `cores.ts` e sao conferidas contra
`tailwind.config.ts` pela suite; a formatacao de numeros e datas fica em
`formatos.ts`.

As regras sao verificadas em `src/testes/graficos.test.tsx`.
</file>

<file path="src/web/src/componentes/graficos/SerieBloqueios.tsx">
/**
 * Bloqueios ao longo do tempo, uma linha por guarda.
 *
 * As series nunca se somam (regra 2 do README): nao existe linha de
 * total, nem pilha, nem area empilhada. Um pico em injecao e incidente de
 * seguranca e um pico em abuso e problema de uso; um total unico
 * esconderia qual dos dois aconteceu.
 */

import { CartesianGrid, Legend, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";

import type { Serie } from "@/tipos";
import { COR_NEUTRA, estiloDaGuarda } from "./cores";
import { formatarDia, formatarInteiro } from "./formatos";
import { TabelaAcessivel } from "./TabelaAcessivel";

type LinhaDoGrafico = { momento: string } & Record<string, number | string>;

/**
 * Reorganiza as series, uma por guarda, em linhas por instante.
 *
 * O Recharts desenha varias linhas a partir de uma lista de objetos com
 * uma chave por serie. A juncao e pelo `momento`, e nao pela posicao, para
 * que uma serie com um ponto a menos nao desloque as demais.
 */
export function porMomento(series: Serie[]): LinhaDoGrafico[] {
  const linhas = new Map<string, LinhaDoGrafico>();
  for (const serie of series) {
    for (const ponto of serie.pontos) {
      const linha = linhas.get(ponto.momento) ?? { momento: ponto.momento };
      linha[serie.nome] = ponto.total;
      linhas.set(ponto.momento, linha);
    }
  }
  return [...linhas.values()].sort((a, b) => a.momento.localeCompare(b.momento));
}

export function SerieBloqueios({ series }: { series: Serie[] }) {
  const dados = porMomento(series);

  return (
    <figure className="rounded-xl border border-slate-200 bg-white p-5">
      <figcaption className="text-sm font-semibold text-slate-900">Bloqueios por guarda</figcaption>
      <div className="mt-4 h-64 w-full" aria-hidden="true">
        <ResponsiveContainer width="100%" height="100%">
          <LineChart data={dados} margin={{ top: 8, right: 16, bottom: 4, left: 0 }}>
            <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
            <XAxis
              dataKey="momento"
              tickFormatter={(momento) => formatarDia(String(momento))}
              tick={{ fill: COR_NEUTRA, fontSize: 11 }}
              minTickGap={16}
            />
            <YAxis allowDecimals={false} width={32} tick={{ fill: COR_NEUTRA, fontSize: 11 }} />
            <Tooltip labelFormatter={(momento) => formatarDia(String(momento))} />
            <Legend verticalAlign="bottom" iconType="plainline" wrapperStyle={{ fontSize: 12 }} />
            {series.map((serie) => {
              const estilo = estiloDaGuarda(serie.nome);
              return (
                <Line
                  key={serie.nome}
                  type="monotone"
                  dataKey={serie.nome}
                  name={estilo.rotulo}
                  stroke={estilo.cor}
                  strokeWidth={2}
                  strokeDasharray={estilo.tracejado}
                  dot={false}
                  isAnimationActive={false}
                />
              );
            })}
          </LineChart>
        </ResponsiveContainer>
      </div>
      <TabelaAcessivel
        legenda="Bloqueios por guarda, por dia"
        colunas={["Dia", ...series.map((serie) => estiloDaGuarda(serie.nome).rotulo)]}
        linhas={dados.map((linha) => [
          formatarDia(linha.momento),
          ...series.map((serie) => formatarInteiro(Number(linha[serie.nome] ?? 0))),
        ])}
      />
    </figure>
  );
}
</file>

<file path="src/web/src/componentes/graficos/TabelaAcessivel.tsx">
/**
 * Versao em tabela dos dados de um grafico, para leitor de tela.
 *
 * O SVG do Recharts e marcado como `aria-hidden`: lido em voz alta, ele
 * vira uma sequencia de numeros de eixo sem relacao entre si. Esta tabela
 * carrega os mesmos dados na forma que a tecnologia assistiva sabe
 * navegar, e fica fora da tela para quem enxerga o grafico.
 */

export function TabelaAcessivel({
  legenda,
  colunas,
  linhas,
}: {
  legenda: string;
  colunas: string[];
  linhas: string[][];
}) {
  return (
    <table className="sr-only">
      <caption>{legenda}</caption>
      <thead>
        <tr>
          {colunas.map((coluna) => (
            <th key={coluna} scope="col">
              {coluna}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {linhas.map((linha) => (
          <tr key={linha[0]}>
            {linha.map((celula, indice) =>
              indice === 0 ? (
                <th key={indice} scope="row">
                  {celula}
                </th>
              ) : (
                <td key={indice}>{celula}</td>
              ),
            )}
          </tr>
        ))}
      </tbody>
    </table>
  );
}
</file>

<file path="src/web/src/componentes/graficos/TabelaEnunciados.tsx">
/**
 * Enunciados recusados, agrupados por repeticao.
 *
 * E o backlog do catalogo em forma de tabela: o que mais se repete vem
 * primeiro, porque e o pedido que mais custa nao atender. Tabela, e nao
 * grafico, porque o dado principal e o texto do pedido, e texto nao cabe
 * em barra.
 *
 * Em tela estreita a tabela rola na horizontal dentro do proprio cartao,
 * em vez de empurrar a pagina inteira para o lado.
 */

import type { EnunciadoAgrupado } from "@/tipos";
import { formatarDataHora, formatarInteiro, formatarPercentual } from "./formatos";

export function TabelaEnunciados({
  titulo,
  enunciados,
  mensagemVazia,
}: {
  titulo: string;
  enunciados: EnunciadoAgrupado[];
  mensagemVazia: string;
}) {
  return (
    <section className="rounded-xl border border-slate-200 bg-white p-5" aria-label={titulo}>
      <h2 className="text-sm font-semibold text-slate-900">{titulo}</h2>
      {enunciados.length === 0 ? (
        <p className="mt-4 text-sm text-slate-600">{mensagemVazia}</p>
      ) : (
        <div className="mt-4 overflow-x-auto">
          <table className="w-full min-w-[520px] text-left text-sm">
            <caption className="sr-only">{titulo}</caption>
            <thead className="border-b border-slate-200 text-xs text-slate-600">
              <tr>
                <th scope="col" className="py-2 pr-4 font-medium">Enunciado</th>
                <th scope="col" className="py-2 pr-4 text-right font-medium">Ocorrências</th>
                <th scope="col" className="py-2 pr-4 text-right font-medium">Confiança média</th>
                <th scope="col" className="py-2 font-medium">Última vez</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100 text-slate-900">
              {enunciados.map((enunciado) => (
                <tr key={enunciado.prompt}>
                  <th scope="row" className="py-2 pr-4 font-normal">{enunciado.prompt}</th>
                  <td className="py-2 pr-4 text-right tabular-nums">
                    {formatarInteiro(enunciado.ocorrencias)}
                  </td>
                  <td className="py-2 pr-4 text-right tabular-nums">
                    {formatarPercentual(enunciado.confianca_media)}
                  </td>
                  <td className="whitespace-nowrap py-2 text-slate-600">
                    {formatarDataHora(enunciado.ultima_em)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  );
}
</file>

