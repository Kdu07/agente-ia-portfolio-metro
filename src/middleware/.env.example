# Variáveis de ambiente do middleware de PLN.
# Copie para .env e preencha os valores reais (o .env NÃO é versionado).

# Copilot Studio — canal Direct Line
DIRECTLINE_ENDPOINT=https://directline.botframework.com
DIRECTLINE_SECRET=

# Banco de auditoria/analytics
DATABASE_URL=postgresql://middleware:middleware@localhost:5432/middleware

# Limiar mínimo de confiança para aceitar uma intenção
INTENT_CONFIDENCE_THRESHOLD=0.7
