# Variáveis de ambiente do middleware.
# Copie para .env e preencha os valores reais (o .env NÃO é versionado).

# --- Copilot Studio — canal Direct Line -------------------------------
DIRECTLINE_ENDPOINT=https://directline.botframework.com
DIRECTLINE_SECRET=
COPILOT_TIMEOUT_SECONDS=30

# --- Banco de dados ---------------------------------------------------
# Interações, conversas, rotinas e o jobstore do APScheduler.
DATABASE_URL=postgresql+asyncpg://middleware:middleware@localhost:5432/middleware
ROTINAS_RECONCILIACAO_SEGUNDOS=30

# --- Mensageria — RabbitMQ ---------------------------------------------
# Acesso padrao exclusivo de desenvolvimento. No Compose, host e porta
# internos sao rabbitmq:5672; fora dele, usar localhost e a porta publicada.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=prata
RABBITMQ_USER=prata
RABBITMQ_PASSWORD=prata-local
# Opcional: URL completa amqp:// ou amqps://, com prioridade sobre os
# componentes acima, inclusive no Compose. Vazio monta a URL automaticamente
# e codifica caracteres especiais de usuario, senha e vhost.
# Em URL explicita, codificar esses caracteres (por exemplo, @ vira %40).
# A senha e a URL sao SecretStr; o cliente AMQP acessara get_secret_value().
RABBITMQ_URL=
RABBITMQ_EXCHANGE=prata.events
RABBITMQ_DEAD_LETTER_EXCHANGE=prata.dead-letter
# Mensagens sem confirmacao de consumo permitidas por consumidor; zero
# significaria sem limite no protocolo e e recusado nesta configuracao.
RABBITMQ_PREFETCH_COUNT=10
# Duas retentativas depois da primeira tentativa: ate tres execucoes.
RABBITMQ_MAX_RETRIES=2
# Para manter broker e clientes com as mesmas credenciais, a partir da raiz:
# docker compose --env-file src/middleware/.env -f infra/docker-compose.yml up -d rabbitmq
# RABBITMQ_USER/PASSWORD/VHOST inicializam apenas um volume novo. Alterar
# o arquivo nao troca credenciais de um broker ja provisionado.
# A publicacao e o consumo serao integrados pelos componentes AMQP.

# --- Identidade — Microsoft Entra ID ----------------------------------
# Obtidos no registro de aplicação do tenant — o da equipe, pela decisão
# D2 de docs/plano-executor-proprio.md, enquanto o do parceiro não existir.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# O mesmo registro de aplicação é usado pelo worker para reler o dono no
# Microsoft Graph a cada disparo de rotina. Em API permissions, conceda
# Microsoft Graph > Application > User.Read.All e aplique admin consent.
# Não use permissão Delegated: não há usuário conectado durante o agendamento.
# Passa pelo proxy do Vite (/api → localhost:8000), para que o retorno do
# login volte pela origem da interface. Precisa ser idêntica à URI de
# redirecionamento registrada no aplicativo do Entra. Sem a interface, o
# endereço direto do middleware é http://localhost:8000/auth/callback.
ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Ids (objectId) dos grupos de segurança que concedem perfil e permissão.
# Quem dá acesso é o administrador do tenant, adicionando a pessoa ao
# grupo — o middleware apenas traduz. Nenhuma lista de usuários no código.
ENTRA_GRUPO_DIRETORIA=
ENTRA_GRUPO_LIDER_PROJETO=
ENTRA_GRUPO_MEMBRO_EQUIPE=
ENTRA_GRUPO_VER_INTENCOES=
ENTRA_GRUPO_GERIR_ROTINAS=

# --- Sessão -----------------------------------------------------------
# Chave de assinatura do cookie httpOnly. Trocá-la invalida todas as
# sessões abertas, que é o comportamento desejado num incidente.
# Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
# Deixe false apenas em desenvolvimento local sem HTTPS.
SESSION_COOKIE_SECURE=true

# --- Contexto multi-turno ---------------------------------------------
# Um turno e um par mensagem do usuario + resposta do agente. Zero
# desativa o contexto sem apagar o historico persistido. O padrao atual e
# conservador e sera recalibrado pela equipe com custo e qualidade medidos.
HISTORICO_MAX_TURNOS=3

# --- Guardas — Azure AI Content Safety --------------------------------
# Prompt Shields (injeção direta e indireta) + categorias de conteúdo (abuso).
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
# Níveis discretos 0, 2, 4 e 6. Limiar 2 escolhido na bancada da issue #411.
CONTENT_SAFETY_LIMIAR_SEVERIDADE=2

# --- Banco vetorial — executor próprio --------------------------------
# `pinecone` é o padrão; `pgvector`, sobre o PostgreSQL acima, é a
# reserva. Trocar de backend é mudar esta linha — ver rag/vetorial/.
VETORIAL_BACKEND=pinecone
# Provisione o índice antes do primeiro uso:
#   python -m app.rag.vetorial.provisionar --criar
PINECONE_API_KEY=
PINECONE_INDEX=portfolio-metro
# Isola ambientes dentro do mesmo índice: dev, bancada, adversarial e
# demo. O corpus adversarial nunca compartilha namespace com a demonstração.
PINECONE_NAMESPACE=dev
# Dimensão (1024) e métrica (cosine) NÃO são configuração: são
# propriedades do modelo de embeddings, fixadas no índice na criação.
# Ver app/rag/vetorial/base.py.

# --- Ingestão do corpus — executor próprio ----------------------------
# Conta de serviço com leitura da pasta controlada do Drive. O JSON da
# chave fica fora do repositório (ou em credenciais/, que o .gitignore
# exclui); aqui entra só o caminho até ele.
DRIVE_SERVICE_ACCOUNT_JSON=
DRIVE_PASTA_ID=
# Orçamento de cada trecho em tokens do e5 (teto do modelo: 512).
CHUNK_TOKENS=350
CHUNK_OVERLAP=40

# --- Autenticidade dos webhooks ---------------------------------------
# Caminho local para o cadastro JSON das chaves do emissor do portfolio.
# Fora do repositorio ou em credenciais/ (ja ignorado pelo Git), com
# leitura restrita ao processo do middleware e escrita aos administradores.
# Caminhos relativos partem do diretorio de execucao do middleware.
# Vazio permite iniciar a aplicacao, mas impede carregar chaves do webhook.
WEBHOOK_PORTFOLIO_CHAVES_ARQUIVO=
# Estrutura do arquivo: lista de registros, um por (source_id, key_id).
# Exemplo de formato, com segredo ficticio que precisa ser substituido:
# [{"source_id":"portfolio","key_id":"k1","segredo_base64":"SUBSTITUIR",
#   "valida_desde":1790035200,"valida_ate":1792627200,"revogada":false}]
# Validade em segundos Unix UTC; ajustar as datas ao periodo de operacao.
# Gerar 32 bytes aleatorios e codificar em Base64 no ambiente seguro do
# emissor. Compartilhar o segredo apenas entre esse emissor e o receptor.
# Para rotacionar, adicionar um key_id novo, migrar o emissor e revogar o
# antigo. Substituir o arquivo de forma atomica; cada carregamento relera
# o cadastro. Falha de leitura/validacao interrompe a autenticacao, sem cache.
# Uso pelo receptor: carregar_chaves_portfolio(
#     settings.webhook_portfolio_chaves_arquivo), em app/auth/webhooks_config.py.

# --- Webhook do Google Drive (WH-01) ----------------------------------
# URL HTTPS publica da rota POST /webhooks/google-drive, como o Google a
# chama. Azure: https://<app-web>/api/webhooks/google-drive (o nginx remove
# /api). Teste local: cloudflared tunnel --url http://127.0.0.1:8000 e a
# URL do tunel seguida de /webhooks/google-drive. Usa a mesma conta de
# servico de DRIVE_SERVICE_ACCOUNT_JSON.
# Inscrever: python -m app.webhooks.drive inscrever (listar, encerrar <id>).
DRIVE_WEBHOOK_URL=
# Identificador interno da fonte acompanhada, nao o ID da pasta.
DRIVE_WEBHOOK_FONTE=corpus_metro_sintetico
# Validade pedida ao Google (1 a 168 horas); renovada a 80% da concedida.
DRIVE_WEBHOOK_VALIDADE_HORAS=24
# Ciclo do worker que republica recebimentos pendentes e renova canais.
# Sem DRIVE_WEBHOOK_URL, o worker so republica os pendentes.
WEBHOOK_MANUTENCAO_SEGUNDOS=60
# Receptor HTTP e provisionamento das credenciais ainda serao integrados.
# Drive: gerar um token aleatorio de 32 bytes (hexadecimal) por canal no
# cadastro de changes.watch; persistir somente SHA-256, validade e recurso.
# Nao existe segredo HMAC global do Drive para configurar neste arquivo.

# --- Recuperação — executor próprio -----------------------------------
# Trechos entregues ao modelo por consulta e corte de similaridade.
# Provisórios até a bancada do RAG medi-los: python -m app.rag.bancada
RAG_TOP_K=5
RAG_SCORE_MINIMO=0.75

# --- Geração — executor próprio ---------------------------------------
# `gemini` é o único adaptador hoje; a porta fica em app/rag/linguagem/.
LLM_BACKEND=gemini
# Chave do Google AI Studio. A pergunta e os trechos recuperados saem
# para o provedor a cada consulta: somente dado sintético (ver o
# perímetro em docs/plano-executor-proprio.md, seção 4.5).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30

# --- Voz — Azure Speech -----------------------------------------------
# A chave fica só no servidor; o navegador recebe token de curta duração.
SPEECH_KEY=
SPEECH_ENDPOINT=
SPEECH_REGION=brazilsouth
SPEECH_IDIOMA=pt-BR
SPEECH_API_VERSION=2025-10-15
SPEECH_TIMEOUT_SECONDS=30

# O limiar de confiança da classificação de intenção não é variável de
# ambiente: fica por intenção em app/pipeline/intencao/catalogo.py.

# --- Executor (docs/plano-executor-proprio.md, seções 3.1, 3.7 e 3.11) ---
# copilot = Copilot Studio via Direct Line (caminho oficial)
# proprio = RAG sobre o corpus do Drive
EXECUTOR=copilot

# --- Geração pelo OpenRouter (LLM_BACKEND=openrouter) ---
# O modelo é o id do OpenRouter, no formato provedor/modelo.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=google/gemini-3.5-flash
OPENROUTER_TIMEOUT_SECONDS=30

# Guarda de saída: domínios que a resposta do executor pode citar em link
# (subdomínios valem). Fora deles, a resposta é retida. Formato JSON.
# SAIDA_DOMINIOS_PERMITIDOS=["metro.sp.gov.br","sharepoint.com","drive.google.com","docs.google.com"]
