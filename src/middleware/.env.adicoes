# --- Adições ao .env (adicione estas linhas ao seu arquivo .env) ---

# --- Copilot Studio (falta o secret) ---
# Você precisa obter isso no portal do Copilot Studio
DIRECTLINE_SECRET=

# --- Guardas — Azure AI Content Safety (opcional, mas recomendado) ---
# Obter no portal do Azure AI Content Safety
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# --- Recuperação — executor próprio (valores padrão) ---
RAG_TOP_K=5
RAG_SCORE_MINIMO=0.75

# --- Geração — executor próprio (obrigatório se usar RAG) ---
LLM_BACKEND=gemini
# Obter no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30

# --- OpenRouter (alternativa ao Gemini, opcional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODELO=google/gemini-3.5-flash
OPENROUTER_TIMEOUT_SECONDS=30

# --- Executor (escolha um) ---
# copilot = Copilot Studio via Direct Line (caminho oficial)
# proprio = RAG sobre o corpus do Drive
EXECUTOR=copilot
